int findNextHop(){
        int best = -1;
        for(int i= 1;i < 3;i++){
            if(routers[i]->count==routers[i]->capacity){
                continue;
            }
            if(best==-1|| routers[i]->count<routers[best]->count){
                best = i;
            }
        }
        return best;
    }